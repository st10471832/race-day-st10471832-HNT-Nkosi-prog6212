@model List<RaceDay.Web.Models.EnrolmentDto>
@{
    ViewData["Title"] = "My Enrolments";
}

<h2 class="mb-3">My Enrolments</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">
        You have not enrolled in any events yet. <a asp-controller="Home" asp-action="Index">Browse events</a>.
    </div>
}
else
{
    <div class="card shadow-sm">
        <table class="table mb-0 align-middle">
            <thead>
                <tr><th>Event</th><th>Date</th><th>Category</th><th>Status</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var e in Model)
                {
                    var badge = e.Status == "Confirmed" ? "badge-confirmed" : e.Status == "Pending" ? "badge-pending" : "bg-secondary";
                    <tr>
                        <td><a asp-controller="Events" asp-action="Details" asp-route-id="@e.EventID">@e.EventName</a></td>
                        <td>@e.EventDate.ToString("dd MMM yyyy")</td>
                        <td>@e.CategoryName</td>
                        <td><span class="badge @badge">@e.Status</span></td>
                        <td class="text-end">
                            <form asp-action="CancelEnrolment" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@e.EnrolmentID" />
                                <button type="submit" class="btn btn-outline-danger btn-sm">Cancel</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}