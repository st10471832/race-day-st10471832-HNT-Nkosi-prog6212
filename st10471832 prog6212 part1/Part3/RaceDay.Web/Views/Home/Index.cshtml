@model List<RaceDay.Web.Models.EventDto>
@{
    ViewData["Title"] = "Upcoming Events";
}

<div class="p-4 mb-4 rounded text-white raceday-nav">
    <h1 class="text-white">Find your next race</h1>
    <p class="mb-0">Browse upcoming runs, walks and cycles, then enrol in minutes.</p>
</div>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

<form method="get" class="row g-2 mb-4">
    <div class="col-md-4">
        <input name="search" value="@ViewBag.Search" class="form-control" placeholder="Search by name" />
    </div>
    <div class="col-md-3">
        <input name="location" value="@ViewBag.Location" class="form-control" placeholder="Location" />
    </div>
    <div class="col-md-3">
        <select name="type" class="form-select">
            <option value="">All types</option>
            <option value="Run" selected="@(ViewBag.Type == "Run")">Run</option>
            <option value="Walk" selected="@(ViewBag.Type == "Walk")">Walk</option>
            <option value="Cycle" selected="@(ViewBag.Type == "Cycle")">Cycle</option>
        </select>
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-primary w-100">Filter</button>
    </div>
</form>

@if (!Model.Any())
{
    <div class="alert alert-info">No upcoming events found.</div>
}

<div class="row">
    @foreach (var e in Model)
    {
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm h-100">
                @if (!string.IsNullOrEmpty(e.BannerImageUrl))
                {
                    <img src="@e.BannerImageUrl" class="card-img-top" alt="@e.EventName" style="height:160px;object-fit:cover;" />
                }
                <div class="card-body">
                    <span class="badge bg-dark mb-2">@e.EventType</span>
                    <h5 class="card-title">@e.EventName</h5>
                    <p class="mb-1">📅 @e.EventDate.ToString("dd MMM yyyy")</p>
                    <p class="mb-1">📍 @e.Location</p>
                    <p class="mb-3">🏁 @e.DistanceKm km</p>
                    <a asp-controller="Events" asp-action="Details" asp-route-id="@e.EventID" class="btn btn-primary btn-sm">View details</a>
                </div>
            </div>
        </div>
    }
</div>