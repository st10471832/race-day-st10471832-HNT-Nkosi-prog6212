@model RaceDay.Web.Models.EventFormViewModel
@{
    ViewData["Title"] = "Edit event";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h2 class="mb-3">Edit event</h2>

                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <form asp-action="EditEvent" method="post">
                    <input type="hidden" asp-for="EventID" />
                    <div class="mb-3">
                        <label asp-for="EventName" class="form-label"></label>
                        <input asp-for="EventName" class="form-control" />
                        <span asp-validation-for="EventName" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="EventDate" class="form-label"></label>
                            <input asp-for="EventDate" class="form-control" type="date" />
                            <span asp-validation-for="EventDate" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="EventType" class="form-label"></label>
                            <select asp-for="EventType" class="form-select">
                                <option value="Run">Run</option>
                                <option value="Walk">Walk</option>
                                <option value="Cycle">Cycle</option>
                            </select>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Location" class="form-label"></label>
                        <input asp-for="Location" class="form-control" />
                        <span asp-validation-for="Location" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="DistanceKm" class="form-label"></label>
                        <input asp-for="DistanceKm" class="form-control" />
                        <span asp-validation-for="DistanceKm" class="text-danger"></span>
                    </div>
                    <button type="submit" class="btn btn-primary">Save changes</button>
                    <a asp-action="Events" class="btn btn-link">Cancel</a>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="row justify-content-center mt-4">
    <div class="col-md-7">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h5>Banner image</h5>

                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success">@TempData["Success"]</div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger">@TempData["Error"]</div>
                }

                <form asp-action="UploadBanner" method="post" enctype="multipart/form-data">
                    <input type="hidden" name="id" value="@Model.EventID" />
                    <input type="file" name="file" accept="image/*" class="form-control mb-3" required />
                    <button type="submit" class="btn btn-primary">Upload banner</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}