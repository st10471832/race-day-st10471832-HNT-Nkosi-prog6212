create
name: Validate Repository Structure 

on: push: branches: [ "" ] pull_request: branches: [ "" ] 

jobs: validate-docs: runs-on: ubuntu-latest steps: - name: Checkout repository uses: actions/checkout@v4 

- name: Check /docs folder exists 
   run: | 
     if [ ! -d "docs" ]; then 
       echo "ERROR: /docs folder is missing." 
       exit 1 
     fi 
     echo "docs folder found." 
 
 - name: Check required planning files are present 
   run: | 
     required_files=("docs/erd.png" "docs/endpoint-plan.md" "docs/database.sql") 
     missing=0 
     for f in "${required_files[@]}"; do 
       if [ ! -f "$f" ]; then 
         echo "ERROR: Required file missing: $f" 
         missing=1 
       else 
         echo "Found: $f" 
       fi 
     done 
     if [ "$missing" -eq 1 ]; then 
       exit 1 
     fi 
 
 - name: Check README exists 
   run: | 
     if [ ! -f "README.md" ]; then 
       echo "ERROR: README.md is missing." 
       exit 1 
     fi 
     echo "README.md found." 
 
 - name: Success 
   run: echo "Repository structure is valid. All required Part 1 planning documents are present."
